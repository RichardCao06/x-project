    {"id":"table_verify","capability":"agent.review","inputs":{"action":"table_verify","runtime_profile":"sol-verifier"},"needs":["table_search_execution_gate"],"gate":"G7C","output":"wiki-table-source-verdict-v2"},
    {"id":"table_population_gate","capability":"wiki.batch","inputs":{"action":"table_population_gate"},"needs":["draft_apply","table_verify"],"gate":"G7D","output":"wiki-table-population-gate-v1"},
