{
  "workflow_id": "wiki-node-production",
  "version": "5",
  "description": "Evidence-gated node Wiki production with a separate source-bound table-data subworkflow, structured composition, independent review and hash-locked release boundaries.",
  "policy_version": "wiki-production-v3",
  "steps": [
    {"id": "plan", "capability": "wiki.batch", "inputs": {"action": "plan"}, "needs": [], "output": "wiki-plan-v5"},
    {"id": "prepare", "capability": "wiki.batch", "inputs": {"action": "prepare"}, "needs": ["plan"], "output": "node-dossier-v5"},
    {"id": "research_ready", "capability": "agent.propose", "inputs": {"action": "nomination"}, "needs": ["prepare"], "gate": "G0", "output": "wiki-proposal-v1"},
    {"id": "verify", "capability": "agent.review", "inputs": {"action": "verify"}, "needs": ["research_ready"], "gate": "G4", "output": "wiki-verdict-v1"},
    {"id": "freeze", "capability": "wiki.batch", "inputs": {"action": "freeze"}, "needs": ["verify"], "output": "wiki-attestation-v1"},
    {"id": "content_compose", "capability": "agent.propose", "inputs": {"action": "content_compose"}, "needs": ["freeze"], "output": "wiki-content-draft-v2"},
    {"id": "editorial_review", "capability": "agent.review", "inputs": {"action": "editorial_review"}, "needs": ["content_compose"], "gate": "G5", "output": "wiki-editorial-review-v1"},
    {"id": "draft_content_gate", "capability": "wiki.batch", "inputs": {"action": "draft_content_gate"}, "needs": ["editorial_review"], "gate": "G6", "output": "draft-content-gate-v5"},
    {"id": "draft_apply", "capability": "release.apply", "inputs": {"action": "draft_apply"}, "needs": ["draft_content_gate"], "output": "wiki-draft-v5"},
    {"id": "table_collect", "capability": "agent.propose", "inputs": {"action": "table_collect"}, "needs": ["freeze"], "output": "wiki-table-evidence-v1"},
    {"id": "table_verify", "capability": "agent.review", "inputs": {"action": "table_verify"}, "needs": ["table_collect"], "gate": "G6T", "output": "wiki-table-source-verdict-v1"},
    {"id": "table_population_gate", "capability": "wiki.batch", "inputs": {"action": "table_population_gate"}, "needs": ["draft_apply", "table_verify"], "gate": "G6P", "output": "wiki-table-population-gate-v1"},
    {"id": "table_apply", "capability": "release.apply", "inputs": {"action": "table_apply"}, "needs": ["table_population_gate"], "output": "wiki-table-apply-v1"},
    {"id": "preview", "capability": "wiki.batch", "inputs": {"action": "preview"}, "needs": ["table_apply"], "output": "wiki-preview-v5"},
    {"id": "release_gate", "capability": "wiki.batch", "inputs": {"action": "release_gate"}, "needs": ["preview"], "gate": "G7", "output": "quality-gate-v5"},
    {"id": "reviewed_apply", "capability": "release.apply", "inputs": {"action": "reviewed_apply"}, "needs": ["release_gate"], "gate": "G8", "output": "wiki-reviewed-v5"},
    {"id": "publish", "capability": "release.apply", "inputs": {"action": "publish"}, "needs": ["reviewed_apply"], "output": "release-record-v1"}
  ]
}
