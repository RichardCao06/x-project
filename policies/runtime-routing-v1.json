{
  "policy_id": "runtime-routing",
  "version": "runtime-routing-v1",
  "profiles": {
    "terra-worker": {"model": "gpt-5.6-terra", "reasoning_effort": "medium", "authority": "propose"},
    "sol-verifier": {"model": "gpt-5.6-sol", "reasoning_effort": "medium", "authority": "read_only_verify"},
    "sol-checker": {"model": "gpt-5.6-sol", "reasoning_effort": "high", "authority": "read_only_gate"}
  },
  "defaults": {"max_model_calls_per_stage": 100, "max_compactions_per_stage": 0, "external_polling": false},
  "forbidden": ["main_chat_as_worker", "unbounded_retry", "short_interval_polling", "implicit_model_selection"]
}
