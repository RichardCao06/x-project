{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wiki-research-plan-v2",
  "title": "Wiki Research Plan with deterministic Research Question Contracts",
  "type": "object",
  "required": [
    "protocol",
    "schema_version",
    "node_id",
    "node_name",
    "terminology",
    "languages",
    "research_questions",
    "research_question_contract_version",
    "research_question_contracts",
    "question_contract_sha256",
    "source_classes",
    "source_role_contract",
    "minimum_source_diversity",
    "plan_sha256"
  ],
  "properties": {
    "protocol": {"const": "wiki-research-plan-v1"},
    "schema_version": {"const": "wiki-research-plan-v2"},
    "node_id": {"pattern": "^[PA][0-9]{3}$"},
    "node_name": {"type": "string", "minLength": 1},
    "terminology": {"type": "object"},
    "terminology_review": {"type": "object"},
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [{"contains": {"const": "zh"}}, {"contains": {"const": "en"}}]
    },
    "research_questions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "research_question_contract_version": {"const": "wiki-research-question-v2"},
    "question_contract_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "research_question_contracts": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/questionContract"}
    },
    "source_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_role_contract": {"type": "object", "minProperties": 1},
    "minimum_source_diversity": {"type": "object"},
    "advisory_candidates": {"type": "array"},
    "historical_registry_policy": {"const": "candidate_only_refetch_and_reverify"},
    "hint_policy": {"const": "advisory_nonexclusive"},
    "field_translations": {"type": "object"},
    "field_translation_policy": {"type": "object"},
    "field_translation_contract": {"type": "object"},
    "plan_sha256": {"pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "questionContract": {
      "type": "object",
      "required": [
        "dimension", "criticality", "applicability", "required_question_ids",
        "source_role_requirements", "preferred_source_classes", "acceptance", "subquestions"
      ],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["required_for_model", "recommended", "contextual"]},
        "applicability": {"type": "string", "minLength": 1},
        "required_question_ids": {"type": "array", "items": {"type": "string"}},
        "source_role_requirements": {"type": "array", "items": {"type": "string"}},
        "preferred_source_classes": {"type": "array", "items": {"type": "string"}},
        "acceptance": {
          "type": "object",
          "required": ["support_type", "must_match_subject_scope", "allow_explicit_gap"]
        },
        "subquestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["question_id", "question", "semantic_frame", "requirement_ids", "closure_rule", "requirement_patterns", "query_intents"],
            "properties": {
              "question_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
              "question": {
                "type": "object",
                "required": ["zh", "en"],
                "properties": {
                  "zh": {"type": "string", "minLength": 1},
                  "en": {"type": "string", "minLength": 1}
                }
              },
              "semantic_frame": {
                "type": "object",
                "required": ["subject", "predicate", "scope", "exclusions"]
              },
              "requirement_ids": {"type": "array", "items": {"type": "string"}},
              "closure_rule": {"const": "all_bound_requirements_confirmed"},
              "requirement_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "query_intents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/queryIntent"}}
            }
          }
        }
      }
    },
    "queryIntent": {
      "type": "object",
      "required": [
        "intent_id", "purpose", "language_policy", "seed_terms",
        "preferred_source_roles", "preferred_source_classes", "priority"
      ],
      "properties": {
        "intent_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "purpose": {"type": "string", "minLength": 1},
        "language_policy": {"type": "string", "minLength": 1},
        "seed_terms": {
          "type": "object",
          "required": ["zh", "en"],
          "properties": {
            "zh": {"type": "array", "items": {"type": "string"}},
            "en": {"type": "array", "items": {"type": "string"}}
          }
        },
        "preferred_source_roles": {"type": "array", "items": {"type": "string"}},
        "preferred_source_classes": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "integer", "minimum": 1}
      }
    }
  },
  "additionalProperties": false
}
