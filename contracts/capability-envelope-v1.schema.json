{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/capability-envelope-v1.schema.json",
  "title": "Capability Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "version",
    "scope",
    "capability_id",
    "runtime_fingerprint",
    "input_scope",
    "budget",
    "certification",
    "known_failures",
    "fallback"
  ],
  "properties": {
    "schema_version": {
      "const": "capability-envelope-v1"
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "minProperties": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt",
        "toolset",
        "workflow"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "toolset": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_scope": {
      "type": "object",
      "minProperties": 1
    },
    "budget": {
      "type": "object",
      "minProperties": 1
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cohort_id",
        "evidence_refs",
        "sample_size",
        "coverage",
        "selective_risk_upper_bound",
        "abstention_recall"
      ],
      "properties": {
        "status": {
          "enum": [
            "shadow",
            "certified",
            "suspended",
            "expired"
          ]
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selective_risk_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "abstention_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "known_failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_state",
        "reason"
      ],
      "properties": {
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
