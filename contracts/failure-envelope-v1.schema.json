{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-envelope-v1",
  "type": "object",
  "required": ["code", "category", "scope", "message", "evidence_artifacts"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "evidence_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reported_retryable": {"type": ["boolean", "null"]},
    "reported_automatic_repair": {"type": ["string", "null"]},
    "reported_invalidates": {"type": "array", "items": {"type": "string"}},
    "reported_preserves": {"type": "array", "items": {"type": "string"}},
    "gate_id": {"type": ["string", "null"]},
    "gate_version": {"type": ["string", "null"]},
    "gate_decision": {"type": ["string", "null"]},
    "failed_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object"},
    "question_contract_sha256": {"type": ["string", "null"]},
    "strategy_hash": {"type": ["string", "null"]},
    "gate_result": {"type": "object"}
  },
  "additionalProperties": false
}
