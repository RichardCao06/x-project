{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-code-repair-result-v1",
  "type": "object",
  "required": [
    "summary", "changed_files", "tests_added", "risk_notes",
    "causal_input_changes_applied", "proof_instrumentation"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "changed_files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tests_added": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risk_notes": {"type": "array", "items": {"type": "string"}},
    "causal_input_changes_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "implementation", "changed_files"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "implementation": {"type": "string", "minLength": 1},
          "changed_files": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "proof_instrumentation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "evidence_artifact", "test"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "evidence_artifact": {"type": "string", "minLength": 1},
          "test": {"type": "string", "pattern": "^tests/"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
