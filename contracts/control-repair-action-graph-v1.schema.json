{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-repair-action-graph-v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "source_triage_run_id", "recovery_task", "actions"],
  "properties": {
    "schema_version": {"const": "control-repair-action-graph-v1"},
    "graph_id": {"type": "string", "pattern": "^crg_[a-f0-9]{32}$"},
    "source_triage_run_id": {"type": "string"},
    "recovery_task": {"type": "string", "pattern": "^$|^[a-z][a-z0-9_]{0,79}$"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id", "kind", "target", "authority", "risk", "status",
          "dependencies", "proof_contract"
        ],
        "properties": {
          "action_id": {"type": "string", "pattern": "^cra_[a-f0-9]{32}$"},
          "kind": {"type": "string"},
          "target": {"type": "string"},
          "authority": {
            "enum": ["automatic", "automatic_analysis_and_validation", "operator"]
          },
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "status": {"enum": ["ready", "awaiting_authority", "running", "completed", "failed"]},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "proof_contract": {"type": "array"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
