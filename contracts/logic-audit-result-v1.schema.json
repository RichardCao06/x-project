{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logic-audit-result-v1",
  "type": "object",
  "required": ["assessment", "summary_zh", "reviewed_actions", "reviewed_conclusions", "findings"],
  "properties": {
    "assessment": {
      "enum": ["coherent", "questionable", "insufficient", "contradictory", "not_assessable"]
    },
    "summary_zh": {"type": "string", "minLength": 1},
    "reviewed_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reviewed_conclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_type", "severity", "confidence", "title_zh", "observation_zh",
          "question_zh", "premise_refs", "conclusion_refs", "artifact_refs"
        ],
        "properties": {
          "finding_type": {
            "enum": [
              "conclusion_without_premises", "precondition_unproven", "scope_overreach",
              "quantifier_escalation", "identity_join_incomplete", "non_sequitur_transition",
              "contradictory_premises", "circular_justification",
              "heuristic_presented_as_fact", "unresolved_presented_as_pass",
              "implicit_question_decomposition", "plan_execution_coverage_gap",
              "decision_reason_missing", "concept_drift", "alternative_unexamined",
              "insufficient_observability", "other"
            ]
          },
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "title_zh": {"type": "string", "minLength": 1},
          "observation_zh": {"type": "string", "minLength": 1},
          "question_zh": {"type": "string", "minLength": 1},
          "premise_refs": {
            "type": "array", "items": {"type": "string", "minLength": 1}
          },
          "conclusion_refs": {
            "type": "array", "items": {"type": "string", "minLength": 1}
          },
          "artifact_refs": {
            "type": "array", "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
