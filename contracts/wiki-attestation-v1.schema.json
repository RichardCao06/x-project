{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wiki-attestation-v1",
  "type": "object",
  "required": ["schema_version", "node_identity", "frozen_input_hash", "agent_id", "attestation_receipt"],
  "properties": {
    "schema_version": {"const": "wiki-attestation-v1"},
    "node_identity": {"type": "object", "required": ["node_id"], "properties": {"node_id": {"type": "string"}}},
    "frozen_input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent_id": {"type": "string", "minLength": 1},
    "attestation": false,
    "attestation_receipt": {"$ref": "#/$defs/proof_receipt"}
  },
  "$defs": {
    "proof_receipt": {
      "type": "object",
      "required": ["proof_id", "artifact_digest", "signature"],
      "properties": {
        "proof_id": {"type": "string", "pattern": "^proof_[a-f0-9]{32}$"},
        "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
