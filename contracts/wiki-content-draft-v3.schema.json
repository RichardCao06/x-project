{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"wiki-content-draft-v3",
  "type":"object","additionalProperties":false,"required":["protocol","node_id","sections"],
  "properties":{"protocol":{"const":"wiki-content-draft-v3"},"node_id":{"type":"string","minLength":1},
    "sections":{"type":"array","minItems":9,"maxItems":9,"items":{"type":"object","additionalProperties":false,
      "required":["section_id","paragraphs"],"properties":{"section_id":{"type":"string","minLength":1},
        "paragraphs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
          "required":["paragraph_id","focus","sentences"],"properties":{"paragraph_id":{"type":"string","minLength":1},
            "focus":{"type":"string","minLength":1},"sentences":{"type":"array","minItems":1,"items":{"type":"object",
              "required":["text","claim_kind","rhetorical_role","evidence_claim_ids"],"properties":{
                "text":{"type":"string","minLength":1},"claim_kind":{"enum":["external_fact","internal_graph_fact","modeling_judgment","evidence_gap"]},
                "rhetorical_role":{"type":"string"},"evidence_claim_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false}}}}}}}}}
}
