{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/assurance-contract-v1.schema.json",
  "title": "Assurance Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "version", "scope", "goal_contract_ref",
    "proof_obligations", "release_rule", "sampling", "recertification_triggers"
  ],
  "properties": {
    "schema_version": {"const": "assurance-contract-v1"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "version": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "minProperties": 1},
    "goal_contract_ref": {"type": "string", "pattern": "^goal://.+@.+$"},
    "proof_obligations": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluator", "evidence_types", "independence_required"],
        "properties": {
          "evaluator": {"type": "string", "minLength": 1},
          "evidence_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "independence_required": {"type": "boolean"}
        }
      }
    },
    "release_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_hard_proved", "all_required_resolved", "no_prohibited_outcomes"],
      "properties": {
        "all_hard_proved": {"type": "boolean"},
        "all_required_resolved": {"type": "boolean"},
        "no_prohibited_outcomes": {"type": "boolean"}
      }
    },
    "sampling": {"type": "object", "minProperties": 1},
    "recertification_triggers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
