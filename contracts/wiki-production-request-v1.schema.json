{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wiki-production-request-v1",
  "type": "object",
  "required": ["industry", "nodes"],
  "properties": {
    "industry": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[PA][0-9]{3}$"}},
    "batch_id": {"type": "string"},
    "publication_mode": {"type": "string", "enum": ["preview", "reviewed"]}
  },
  "additionalProperties": false
}
