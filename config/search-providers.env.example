# 复制到项目根目录的 .env.search.local，再填写真实密钥。
# cp config/search-providers.env.example .env.search.local
# .env.search.local 已加入 .gitignore；不要提交或粘贴到 Dashboard 任务请求中。

QIANFAN_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# 当前 Google 采用浏览器人工接管兜底，不需要 API Key。
# 如果以后改为 SerpApi 等正式接口，应新增独立 Provider 和环境变量，
# 不要让后台 Worker 直接抓取 Google SERP HTML。
